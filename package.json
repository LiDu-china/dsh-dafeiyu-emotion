{
  "name": "dsh-dafeiyu-emotion",
  "version": "0.2.9",
  "description": "大肥鱼语音情绪耳朵：听语气、识别情绪，并让 DSH 按对方当下的状态自然回复。 · Voice + emotion-aware companion for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "icon": "./assets/icon-512.png",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "lib/*.js",
    "backend/*.py",
    "docs/*.md",
    "docs/*.svg",
    "docs/*.png",
    "scripts/*.mjs",
    "assets/*.png",
    "screenshots.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-dafeiyu",
    "deepseek",
    "voice",
    "emotion",
    "speech",
    "emotion2vec",
    "sensevoice",
    "voice-assistant",
    "speech-emotion-recognition"
  ],
  "author": {
    "name": "LiDu-china",
    "url": "https://github.com/LiDu-china"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiDu-china/dsh-dafeiyu-emotion.git"
  },
  "homepage": "https://github.com/LiDu-china/dsh-dafeiyu-emotion#readme",
  "bugs": {
    "url": "https://github.com/LiDu-china/dsh-dafeiyu-emotion/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check lib/client.js",
    "test": "node --check src/index.js && node --check lib/client.js && node --test scripts/test-config-schema.mjs scripts/test-config-handler.mjs scripts/test-analyze-handler.mjs scripts/test-backend-cancel.mjs scripts/test-delivery-policy.mjs scripts/test-shortcut-registration.mjs scripts/test-client-registration.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "dsh-dafeiyu": "0.1.23"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
